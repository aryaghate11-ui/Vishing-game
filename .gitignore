# Node.js dependencies (phone-calling-system relay)
node_modules/
npm-debug.log*

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size
[Mm]emory[Cc]aptures/

# Recordings
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Crash log files
sysinfo.txt
crashlytics-build.properties
gradle.properties

# Compressed files
*.7z
*.gz
*.rar
*.zip

# Build results
[Ee]xport/
[Ee]xports/
[Aa]pp[Dd]ata/
[Aa]pp[Bb]undles/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Large binary package files inside Assets
Assets/**/*.unitypackage

# Large HDRI/environment files (can exceed GitHub's 100MB limit)
*.hdr
*.exr

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/**/[Bb]uildPlayerContent/
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# macOS
.DS_Store
